{
  "name": "xenboox",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native, full-stack accounting platform for Africa",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:eval": "turbo test:eval --filter=agents",
    "db:generate": "pnpm --filter=@xenboox/db generate",
    "db:migrate": "pnpm --filter=@xenboox/db migrate",
    "db:push": "pnpm --filter=@xenboox/db push",
    "db:seed": "pnpm --filter=@xenboox/db seed",
    "db:studio": "pnpm --filter=@xenboox/db studio",
    "setup": "node scripts/setup.mjs",
    "agents:eval": "pnpm --filter=@xenboox/agents eval",
    "agents:trace": "open https://langfuse.xenboox.com",
    "prepare": "npx husky install"
  },
  "devDependencies": {
    "@types/pino": "^7.0.5",
    "chrome-devtools-mcp": "^1.6.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "puppeteer-core": "^25.4.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.12.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "nanoid": "^6.0.1"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.1"
    }
  }
}
