{
  "name": "xenboox",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native, full-stack accounting platform for Africa",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:eval": "turbo test:eval --filter=agents",
    "db:generate": "pnpm --filter=@xenboox/db generate",
    "db:migrate": "pnpm --filter=@xenboox/db migrate",
    "db:push": "pnpm --filter=@xenboox/db push",
    "db:seed": "pnpm --filter=@xenboox/db seed",
    "db:studio": "pnpm --filter=@xenboox/db studio",
    "setup": "node scripts/setup.mjs",
    "agents:eval": "pnpm --filter=@xenboox/agents eval",
    "agents:trace": "open https://langfuse.xenboox.com",
    "email:dev": "pnpm --filter=@xenboox/email email:dev",
    "prepare": "npx husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@rollup/rollup-win32-x64-msvc": "4.63.1",
    "@types/pino": "^7.0.5",
    "chrome-devtools-mcp": "^1.8.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "puppeteer-core": "^25.9.0",
    "turbo": "^2.10.12",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.12.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "nanoid": "^6.0.0"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.1",
      "react-router": "7.18.2",
      "socket.io": "4.8.3",
      "engine.io": "6.6.9",
      "ws": "8.21.0",
      "socket.io-parser": "4.2.7",
      "cookie": "0.7.2",
      "sharp": "0.35.3",
      "langsmith": "0.6.3",
      "prismjs": "1.30.0",
      "nanoid@<4": "3.3.18",
      "@opentelemetry/core": "2.10.0",
      "fast-uri": "3.1.5",
      "brace-expansion": "1.1.18",
      "js-yaml": "3.15.1",
      "undici": "6.28.0",
      "postcss": "8.5.26",
      "tar": ">=7.5.21",
      "image-size": ">=1.2.2",
      "@xmldom/xmldom": ">=0.8.13"
    }
  }
}
