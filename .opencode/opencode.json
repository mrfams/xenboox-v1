{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["./.agents/skills"]
  },
  "permission": {
    "skill": {
      "*": "ask"
    }
  },
  "model": "z-ai/glm-5.3-free",
  "small_model": "z-ai/glm-5.3-free",
  "provider": {
    "zenmux": {
      "options": {
        "baseURL": "https://zenmux.ai/api/v1",
        "apiKey": "{env:ZENMUX_API_KEY}"
      }
    },
    "z-ai": {
      "options": {
        "apiKey": "{env:Z_AI_API_KEY}"
      }
    },
    "zai": {
      "options": {
        "apiKey": "{env:ZAI_API_KEY}"
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp",
        "--headless",
        "--isolated"
      ],
      "enabled": true
    },
    "gbrain": {
      "type": "local",
      "command": ["npx", "-y", "gbrain", "serve"],
      "environment": {
        "GBRAIN_BRAIN_DIR": "${workspaceFolder}/.brain",
        "GBRAIN_DB_PATH": "${workspaceFolder}/.brain/data"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic/mcp-server-sequential-thinking"],
      "enabled": false
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@anthropic/mcp-server-filesystem",
        "${workspaceFolder}"
      ],
      "enabled": false
    }
  }
}
