# Database
DATABASE_URL=                    # Neon PostgreSQL connection string

# Auth
AUTH_SECRET=                     # Auth.js secret (generate with: openssl rand -base64 32)
AUTH_GOOGLE_ID=                  # Google OAuth client ID
AUTH_GOOGLE_SECRET=              # Google OAuth client secret
NEXTAUTH_URL=                    # e.g., http://localhost:3000

# LLM (Multi-Provider)
ANTHROPIC_API_KEY=              # Claude API key (primary)
OPENAI_API_KEY=                 # OpenAI API key (fallback)
LLM_STRATEGIC_MODEL=claude-sonnet-4-6
LLM_MANAGEMENT_MODEL=claude-sonnet-4-6
LLM_WORKER_MODEL=claude-haiku-4-5
LLM_FAST_MODEL=claude-haiku-4-5
LLM_MONTHLY_BUDGET_CENTS=50000 # $500/month max across all providers

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=                  # Cloudflare account ID
R2_ACCESS_KEY_ID=               # R2 access key
R2_SECRET_ACCESS_KEY=           # R2 secret key
R2_BUCKET_NAME=xenboox-uploads  # R2 bucket name
R2_PUBLIC_URL=                  # Public URL for R2 bucket

# Webhook Security
WEBHOOK_SECRET=                 # Shared secret for webhook signature verification
MONO_WEBHOOK_SECRET=            # Mono API webhook secret

# Email (Resend)
RESEND_API_KEY=                 # Resend API key
RESEND_FROM_EMAIL=              # e.g., notifications@xenboox.com

# Observability (LangFuse)
LANGFUSE_PUBLIC_KEY=            # LangFuse public key
LANGFUSE_SECRET_KEY=            # LangFuse secret key
LANGFUSE_BASE_URL=              # LangFuse instance URL

# Job Queue (Trigger.dev)
TRIGGER_SECRET_KEY=             # Trigger.dev secret key
TRIGGER_API_KEY=                # Trigger.dev API key

# App
NEXT_PUBLIC_APP_URL=            # e.g., http://localhost:3000
NODE_ENV=development            # development | production | test

# Mobile Money (ModemPay — CBG Licensed, The Gambia)
MODEMPAY_SECRET_KEY=            # ModemPay API secret key
MODEMPAY_PUBLIC_KEY=            # ModemPay public key (client-side)
MODEMPAY_WEBHOOK_SECRET=        # Webhook signature verification secret
MODEMPAY_ENV=sandbox            # sandbox | production

# Exchange Rates (ECB - free, no key needed)
EXCHANGE_RATE_SOURCE=ECB

# Rate Limiting (Upstash Redis - serverless-friendly)
UPSTASH_REDIS_REST_URL=              # Upstash Redis REST URL
UPSTASH_REDIS_REST_TOKEN=            # Upstash Redis REST token
# Optional: Set USE_RLS=true to enable Row-Level Security with WebSocket mode
NEON_WEBSOCKET=                      # Set to "true" to enable WebSocket mode for RLS
USE_RLS=                             # Set to "true" to enable RLS policies

# Error Tracking (Sentry)
SENTRY_DSN=                          # Sentry DSN (from sentry.io)
SENTRY_ORG=                          # Sentry organization slug
SENTRY_PROJECT=                      # Sentry project slug
NEXT_PUBLIC_SENTRY_DSN=              # Public DSN for client-side (optional, same as SENTRY_DSN)

# Distributed Tracing (OpenTelemetry) — unset = disabled (silent no-op)
# MOCK VALUES — replace with real collector credentials before launch.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com   # any OTLP/HTTP collector (SigNoz, Tempo, New Relic, Datadog...)
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer MOCK_OTEL_COLLECTOR_TOKEN
OTEL_SERVICE_NAME=xenboox-web
OTEL_TRACES_SAMPLER=parentbased_traceidratio   # always_on | always_off | parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1                    # ratio when *traceidratio* (0.1 = 10%)
# OTEL_SDK_DISABLED=true                        # hard kill-switch
