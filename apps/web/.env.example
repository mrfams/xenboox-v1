# Xenboox Web App Environment Variables
# Copy this file to .env.local and fill in the values

# Required: App URL (used for metadata, links in emails, server-side tRPC,
# auth emails). Production: https://xenboox.vercel.app — local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://xenboox.vercel.app

# Auth
AUTH_SECRET=your-auth-secret-here
# Idle session timeout in minutes — JWT sessions auto-expire after this
# period without any request activity. Default: 60.
AUTH_IDLE_TIMEOUT_MINUTES=60

# SSO (Azure AD, Okta, Keycloak, Auth0, generic OIDC/SAML bridge)
# SSO_ENABLED=false
# SSO_PROVIDER=azure|okta|oidc|saml|none
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_ISSUER=
# SSO_CALLBACK_URL=
# SSO_DOMAIN=
# SSO_ENFORCE=false
# SSO_JIT=true
# SAML_ENTRY_POINT=
# SAML_CERT=

# SCIM 2.0 Provisioning (for enterprise SSO providers)
# SCIM_BEARER_TOKEN=your-scim-bearer-token

# Database
DATABASE_URL=postgresql://localhost:5432/xenboox
# RLS — set true to activate Pool (WebSocket) + DB-layer enforcement (see ADR-RLS-POOL.md + DATABASE.md §14). Default false = neon-http, app-layer primary.
USE_RLS=false

# Email (Resend)
RESEND_API_KEY=re_xxxxx

# File Storage (Cloudflare R2 or S3-compatible)
# R2_BUCKET_NAME=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Distributed Tracing (OpenTelemetry) — unset = disabled (silent no-op)
# MOCK VALUES — replace with real collector credentials before launch.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer MOCK_OTEL_COLLECTOR_TOKEN
OTEL_SERVICE_NAME=xenboox-web
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_SDK_DISABLED=true

# ─── Plaid (Bank Feeds) ──────────────────────────────────────────
# Get keys at https://dashboard.plaid.com/developers/keys
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET=your_plaid_secret
# PLAID_ENV=sandbox  # sandbox | development | production

# ─── Field Encryption (at-rest) ─────────────────────────────
# AES-256-GCM master key — MUST match the value in the root .env for
# bank connection token encryption (used by web + jobs packages).
FIELD_ENCRYPTION_KEY=
# NEXT_PUBLIC_DEMO_MODE=true  # opt-in demo bank connections (never in prod)
