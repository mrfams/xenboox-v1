{
  "buildCommand": "pnpm build --filter=@xenboox/web",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_POSTHOG_KEY": "@posthog-key",
    "NEXT_PUBLIC_POSTHOG_HOST": "@posthog-host"
  },
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/month-end-close",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/bank-feed-sync",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/webhooks/process?batch=200",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/data-retention",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/audit-archive",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/onboarding-drip",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/customer-health",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/churn-prevention",
      "schedule": "0 12 * * *"
    }
  ]
}
